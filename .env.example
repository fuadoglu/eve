# Local development only. Copy to .env.local and use values from a local
# Supabase project. Do not commit .env.local or real credentials.

# Project URL and publishable key may be exposed to browser code. RLS remains
# the authorization boundary for every exposed request.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Privileged key. Server-only; use only for explicitly authorized operations.
SUPABASE_SECRET_KEY=
